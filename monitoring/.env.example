# Monitoring Stack Environment Variables
# Copy to .env in this directory and fill in real values
# chmod 600 .env

########################################
# Prometheus Configuration
########################################
# Image tag (default: v3.2.0)
PROMETHEUS_IMAGE_TAG=v3.2.0

# Prometheus port binding (internal-only, accessed via SSH tunnel)
PROMETHEUS_HOST_PORT=127.0.0.1:9090

# Data retention (default: 30 days)
# PROMETHEUS_RETENTION=30d

########################################
# Grafana Configuration
########################################
# Image tag (default: 11.6.0)
GRAFANA_IMAGE_TAG=11.6.0

# Grafana admin credentials (CHANGE ON FIRST SETUP, treat as immutable)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-TO-SECURE-PASSWORD

# Grafana port binding (internal-only, accessed via SSH tunnel)
GRAFANA_HOST_PORT=127.0.0.1:3000

########################################
# Network Configuration
########################################
# If running on a different host than LiteLLM stack, configure network:
# COMPOSE_PROJECT_NAME=monitoring (optional, for namespace isolation)
