      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE) * 100",
          "refId": "A",
          "legendFormat": "{{server}} gpu{{gpu}}{{GPU_I_ID}}"
        }
      ],
      "description": "NOTE: this is allocation, not load. vLLM pre-allocates its KV cache at startup (your containers run --gpu-memory-utilization 0.8-0.95), so this line sits nearly flat regardless of how busy the GPU is. Useful for capacity/OOM headroom, NOT as a utilization signal. For actual load on llm2, see the Power Draw and SM Clock panels below.",
      "title": "GPU Memory Allocated (%) — capacity, not load (see panel description)",
      "type": "timeseries"
    },
