        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "refId": "A",
          "legendFormat": "{{server}} gpu{{gpu}}"
        }
      ],
      "description": "llm1 only. DCGM_FI_DEV_GPU_UTIL is not emitted on llm2 because that GPU is in MIG mode — verified: both hosts ship an identical default-counters.csv listing this field, but only the non-MIG host reports values, so the driver is withholding it, not the exporter config. For llm2 load, use Power Draw and SM Clock.",
      "title": "Compute Utilization (%) — llm1 only (MIG blocks this metric on llm2)",
      "type": "timeseries"
    },

