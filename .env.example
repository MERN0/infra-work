# Copy this file to .env and fill in real values.
# .env must NEVER be committed — it's already covered by .gitignore.
# chmod 600 .env on the server once populated.

########################################
# Image version overrides
########################################
# Defaults baked into docker-compose.yml are the actual-latest stable releases
# as of 2026-08-19 (checked against Docker Hub directly, not memory):
#   litellm/litellm            v1.97.0   (Docker Hub — main-stable tag; avoids ghcr.io)
#   postgres (both instances)  18.6-alpine
#   clickhouse-server          26.6.3-alpine
#   redis                      8.0.1-alpine
#   langfuse / langfuse-worker 4.14.0    (v4 — breaking changes vs v3, see below)
#   minio/minio                RELEASE.2025-09-07T16-13-09Z (frozen — MinIO
#                               stopped publishing to Docker Hub in Oct 2025;
#                               this is the last tag that exists there, not a
#                               stale pin. Actively-maintained alternative if
#                               reachable: cgr.dev/chainguard/minio:latest)
#
# MIGRATING EXISTING DATA: leave these unset to take the defaults ONLY on a
# fresh install. If attaching to existing volumes (see RUNBOOK.md), first run
# on the OLD stack:  docker inspect <container> --format '{{.Config.Image}}'
# for litellm-db, langfuse-postgres, langfuse-clickhouse, and langfuse-web —
# and set the matching var below to that SAME version for the initial cutover.
# Postgres and ClickHouse data directories are version-format-specific; jumping
# a major version as a side effect of adopting this compose file can prevent
# the new container from starting against your old data. Upgrade deliberately
# afterward via pg_upgrade / langfuse.com/self-hosting/upgrade, not by editing
# this file.
LITELLM_IMAGE_TAG=
LITELLM_POSTGRES_IMAGE_TAG=
LANGFUSE_IMAGE_TAG=
LANGFUSE_POSTGRES_IMAGE_TAG=
CLICKHOUSE_IMAGE_TAG=
REDIS_IMAGE_TAG=
MINIO_IMAGE_TAG=

########################################
# Existing-volume names (MIGRATION — fill from scripts/00_backup_existing_stack.sh MANIFEST.txt)
########################################
# These MUST match the exact volume names your current stack already uses,
# so docker-compose.yml (which declares them `external: true`) attaches to
# your EXISTING data instead of creating empty new volumes. If you are doing
# a genuinely fresh install with no prior data, instead remove `external: true`
# from the matching volume blocks in docker-compose.yml and leave these unset.
LANGFUSE_POSTGRES_VOLUME_NAME=
LANGFUSE_CLICKHOUSE_VOLUME_NAME=
LANGFUSE_MINIO_VOLUME_NAME=
LITELLM_POSTGRES_VOLUME_NAME=

########################################
# LiteLLM
########################################
# Admin/master key — used only for admin API calls (key creation etc.), never
# hand this to client apps. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-CHANGE-ME

# LiteLLM's own Postgres (virtual keys, spend tracking, team config)
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=CHANGE-ME
LITELLM_DB_NAME=litellm

########################################
# The 12 upstream provider API keys fronted by LiteLLM
# Rename/replace these to match your actual providers — placeholders shown.
########################################
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
COHERE_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
# Add/remove entries here to match your real 12 keys, and update
# litellm/config.yaml's model_list to reference them.

########################################
# Self-hosted vLLM (gpt-oss-130b) on a separate machine
########################################
VLLM_API_BASE=http://YOUR-VLLM-HOST:8000/v1
VLLM_API_KEY=CHANGE-ME

########################################
# Langfuse
########################################
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=CHANGE-ME
LANGFUSE_POSTGRES_DB=langfuse

LANGFUSE_CLICKHOUSE_USER=default
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE-ME

LANGFUSE_MINIO_ROOT_USER=langfuse-minio
LANGFUSE_MINIO_ROOT_PASSWORD=CHANGE-ME

LANGFUSE_REDIS_PASSWORD=CHANGE-ME

# Generate each of these ONCE and never rotate without a migration plan —
# rotating ENCRYPTION_KEY/SALT breaks decryption of already-stored data.
#   openssl rand -hex 32   (for NEXTAUTH_SECRET and ENCRYPTION_KEY)
#   openssl rand -base64 32 (for SALT)
LANGFUSE_NEXTAUTH_SECRET=CHANGE-ME
LANGFUSE_SALT=CHANGE-ME
LANGFUSE_ENCRYPTION_KEY=CHANGE-ME

# Created after first login via the Langfuse UI (Settings -> API Keys),
# per project. Feed these into LiteLLM so it can send traces.
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE-ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE-ME
LANGFUSE_HOST=http://langfuse-web:3000

########################################
# Local port bindings (internal-only — bound to 127.0.0.1, access via SSH tunnel)
########################################
LITELLM_HOST_PORT=127.0.0.1:4000
LANGFUSE_HOST_PORT=127.0.0.1:3000

# Note: Prometheus & Grafana configuration is in monitoring/.env.example
# See monitoring/README.md for separate monitoring stack setup
